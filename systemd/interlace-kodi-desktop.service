[Unit]
Description=Kodi on the GNOME desktop
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/gnome-session-inhibit --app-id=org.xbmc.Kodi --reason=Kodi-on-TV --inhibit=idle /usr/bin/kodi --windowing=wayland
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
